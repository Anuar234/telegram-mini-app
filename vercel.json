{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "includeFiles": [
        "public/**",
        "src/public/**"
      ]
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/api/webhook",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/assets",
      "dest": "api/assets.py"
    },
    {
      "src": "/api/app",
      "dest": "api/app.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "api/assets.py"
    },
    {
      "src": "/app",
      "dest": "api/app.py"
    }
  ]
}
